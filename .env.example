# =============================================================================
# Non-secret configuration only. Real secrets live in macOS Keychain — see
# docs/INSTALL.md 단계 5–7 and run-bot.sh. Do NOT add DISCORD_TOKEN or
# MOONSHOT_API_KEY to this file.
# =============================================================================

# Discord (non-secret)
DISCORD_GUILD_ID=
# DISCORD_CLIENT_ID — not read by code. Kept here only as a reminder if you
# want to hand-build the OAuth2 invite URL in docs/INSTALL.md 단계 3.
# DISCORD_CLIENT_ID=

# Local paths / defaults
SESSION_DB_PATH=./sessions.sqlite3
CMUX_CMD=/Applications/cmux.app/Contents/Resources/bin/cmux
DEFAULT_WORK_DIR=/Users/me/IdeaProjects

# Sleep guard policy for locked-screen remote work:
# - off: never prevent sleep
# - active_sessions: prevent sleep only while at least one kimi session exists
# - always: prevent sleep whenever the bridge is running (best for remote /new)
SLEEP_GUARD_MODE=always

# Drop old Discord messages instead of executing them after a long sleep/wake
# delay. Set 0 to disable the age check.
QUEUE_MAX_MESSAGE_AGE_SEC=300

# Wire fallback / cmux restore
# When cmux terminal RPC fails while locked, the bridge can temporarily route
# prompts through Kimi Agent SDK (`kimi --wire`) and later restore the same
# session into cmux with `kimi --session <session_id>`.
# Override only if you need a custom node command/path.
# KIMI_WIRE_BRIDGE_CMD=node router/kimi_wire_bridge.mjs
# KIMI_NODE_CMD=/opt/homebrew/bin/node     # node 바이너리 경로 override (PATH 못 찾을 때)
RESTORE_WATCH_INTERVAL_SEC=5
RESTORE_RETRY_BACKOFF_SEC=60
# Longer pause when cmux returns inconsistent not_found errors during restore.
RESTORE_CMUX_UNHEALTHY_BACKOFF_SEC=600

# Wire fallback 디버그 출력 (기본 off — 보통은 그대로 둘 것)
# KIMI_WIRE_SHOW_TOOLS=1       # 도구 호출 이벤트도 Discord 로 surface
# KIMI_WIRE_SHOW_THINKING=1    # thinking 토큰 stream 도 surface

# 봇 싱글톤 락 파일 (기본: router.bot.pid). 같은 호스트에서 동시 다중 인스턴스 차단.
# BOT_PID_FILE=router.bot.pid

# Legacy alias: if SLEEP_GUARD_MODE is unset and this is 1, the bridge treats
# it as SLEEP_GUARD_MODE=active_sessions.
# PREVENT_SLEEP_WHILE_ACTIVE=1
